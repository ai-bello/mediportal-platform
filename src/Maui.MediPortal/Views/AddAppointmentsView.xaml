<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.MediPortal.Views.AddAppointmentsView"
             Title="AddAppointmentsView"
             NavigatedTo="AddAppointmentsView_NavigatedTo">
    <VerticalStackLayout
        Padding="30,0"
        Spacing="25">
        <Picker
            Title="Patient Selection"
            ItemsSource="{Binding Patients}"
            ItemDisplayBinding="{Binding Name}"
            SelectedItem="{Binding SelectedPatient}" />
        <Picker
            Title="Physician Selection"
            ItemsSource="{Binding Physicians}"
            ItemDisplayBinding="{Binding Name}"
            SelectedItem="{Binding SelectedPhysician}" />


        <Label Text="Date Selection" />
        <DatePicker
            Date="{Binding SelectedDate}"
            MinimumDate="{Binding MinimumSelectedDate}"
            />
        <Picker
            Title="Time Selection"
            ItemsSource="{Binding AvailableTimes}"
            SelectedItem="{Binding SelectedTime}" />
        <Button Text="Save" Clicked="SaveClicked" />
        <Button Text="Cancel" Clicked="CancelClicked" />

    </VerticalStackLayout>
</ContentPage>